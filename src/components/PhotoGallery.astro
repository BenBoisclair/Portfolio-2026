---
import type { Photo } from "../data/portfolio";

interface Props {
  photos: Photo[];
  label?: string;
}
const { photos, label } = Astro.props;

const THUMB_H = 360; // intrinsic height of the thumb files
---

<section class="gallery-wrap" data-gallery>
  <div class="head">
    <span class="mono lbl">{label ?? "Photos"}</span>
    <span class="mono hint">{photos.length} photos · click to expand</span>
  </div>

  <ul class="gallery">
    {
      photos.map((p, i) => (
        <li>
          <button
            class="thumb"
            style={`--ar: ${p.w} / ${p.h}`}
            data-full={p.full}
            data-caption={p.caption}
            data-index={i}
            aria-label={`Expand photo: ${p.caption}`}
          >
            <img
              src={p.thumb}
              alt={p.alt}
              width={Math.round((THUMB_H * p.w) / p.h)}
              height={THUMB_H}
              loading="lazy"
              decoding="async"
            />
          </button>
        </li>
      ))
    }
  </ul>

  <div
    class="lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
    hidden
  >
    <button class="lb-btn lb-close" aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <button class="lb-btn lb-prev" aria-label="Previous photo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M15 5l-7 7 7 7" />
      </svg>
    </button>
    <figure class="lb-stage">
      <img class="lb-img" src="" alt="" />
      <figcaption class="lb-caption mono"></figcaption>
    </figure>
    <button class="lb-btn lb-next" aria-label="Next photo">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M9 5l7 7-7 7" />
      </svg>
    </button>
  </div>
</section>

<style>
  .gallery-wrap {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }
  .lbl {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hint {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .gallery {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0 0 0.85rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 1.25rem,
      #000 calc(100% - 2.5rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 1.25rem,
      #000 calc(100% - 2.5rem),
      transparent 100%
    );
  }
  .gallery::-webkit-scrollbar {
    height: 6px;
  }
  .gallery::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 100px;
  }
  .gallery li {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  .thumb {
    display: block;
    height: var(--thumb-h, 172px);
    aspect-ratio: var(--ar);
    padding: 0;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    background: var(--paper-sunk);
    cursor: pointer;
    transition:
      transform 0.18s ease,
      box-shadow 0.18s ease;
  }
  .thumb:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(26, 26, 26, 0.16);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ---- Lightbox ---- */
  .lightbox[hidden] {
    display: none;
  }
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    padding: clamp(1rem, 4vw, 3rem);
    background: rgba(18, 17, 16, 0.94);
  }
  .lb-stage {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: min(1100px, 92vw);
  }
  .lb-img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 4px;
    background: #000;
  }
  .lb-caption {
    color: #e8e6e2;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-align: center;
    margin: 0;
    min-height: 1em;
  }
  .lb-btn {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #f2f0ec;
    border-radius: 100px;
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }
  .lb-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.5);
  }
  .lb-btn svg {
    width: 1.4rem;
    height: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .lb-prev,
  .lb-next {
    width: 2.75rem;
    height: 2.75rem;
  }
  .lb-close {
    position: absolute;
    top: clamp(0.75rem, 3vw, 1.5rem);
    right: clamp(0.75rem, 3vw, 1.5rem);
    width: 2.4rem;
    height: 2.4rem;
  }
  .lb-close svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (max-width: 480px) {
    .gallery-wrap {
      margin-inline: calc(-1 * var(--gutter));
    }
    .head {
      padding-inline: var(--gutter);
    }
    .gallery {
      padding-inline: var(--gutter);
    }
    .thumb {
      --thumb-h: 150px;
    }
    .lb-prev,
    .lb-next {
      width: 2.25rem;
      height: 2.25rem;
    }
  }
</style>

<script>
  function setupGallery(root: Element) {
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>(".thumb"));
    const lb = root.querySelector<HTMLElement>(".lightbox");
    if (!lb || thumbs.length === 0) return;
    const img = lb.querySelector<HTMLImageElement>(".lb-img")!;
    const cap = lb.querySelector<HTMLElement>(".lb-caption")!;
    const closeBtn = lb.querySelector<HTMLButtonElement>(".lb-close")!;
    let idx = -1;
    let lastFocus: HTMLElement | null = null;

    function show(i: number) {
      idx = (i + thumbs.length) % thumbs.length;
      const t = thumbs[idx];
      img.src = t.dataset.full || "";
      const inner = t.querySelector("img");
      img.alt = inner ? inner.alt : "";
      cap.textContent = t.dataset.caption || "";
    }
    function open(i: number) {
      lastFocus = document.activeElement as HTMLElement;
      show(i);
      lb!.hidden = false;
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    }
    function close() {
      lb!.hidden = true;
      img.src = "";
      document.body.style.overflow = "";
      if (lastFocus) lastFocus.focus();
    }

    thumbs.forEach((t, i) => t.addEventListener("click", () => open(i)));
    closeBtn.addEventListener("click", close);
    lb.querySelector(".lb-prev")!.addEventListener("click", () => show(idx - 1));
    lb.querySelector(".lb-next")!.addEventListener("click", () => show(idx + 1));
    lb.addEventListener("click", (e) => {
      const el = e.target as HTMLElement;
      if (el === lb || el.classList.contains("lb-stage")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (lb!.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") show(idx - 1);
      else if (e.key === "ArrowRight") show(idx + 1);
    });
  }

  document.querySelectorAll("[data-gallery]").forEach(setupGallery);
</script>
