---
import type { Screen } from "../data/portfolio";

interface Props {
  screens: Screen[];
  label?: string;
}
const { screens, label } = Astro.props;

// Uniform panel box. Every panel renders exactly BOX_W x BOX_H, so tall screens
// become several consecutive panels and the whole strip shares one height.
const BOX_W = 264;
const BOX_H = 580;

const groups = screens.map((s) => {
  const scaledH = (s.h * BOX_W) / s.w; // image height once scaled to panel width
  const panels = Math.max(1, Math.ceil(scaledH / BOX_H));
  const maxOffset = Math.max(0, scaledH - BOX_H);
  const offsets = Array.from({ length: panels }, (_, i) =>
    Math.round(Math.max(0, Math.min(i * BOX_H, maxOffset))),
  );
  return { ...s, panels, offsets };
});

const totalPanels = groups.reduce((n, g) => n + g.panels, 0);
---

<section
  class="filmstrip-wrap"
  style={`--box-w:${BOX_W}px; --box-h:${BOX_H}px;`}
>
  <div class="head">
    <span class="mono lbl">{label ?? "Product walkthrough"}</span>
    <span class="mono hint">{groups.length} screens · drag →</span>
  </div>

  <div
    class="filmstrip"
    tabindex="0"
    role="group"
    aria-label={label ?? "Product screenshots"}
  >
    {
      groups.map((g) => (
        <figure class="group">
          <div class="panels">
            {g.offsets.map((offset, i) => (
              <div class="panel" style={`--offset:${offset}px`}>
                <img
                  src={g.src}
                  alt={i === 0 ? g.alt : ""}
                  aria-hidden={i === 0 ? undefined : "true"}
                  width={g.w}
                  height={g.h}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))}
          </div>
          <figcaption class="cap mono">{g.caption}</figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .filmstrip-wrap {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.85rem;
  }
  .lbl {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hint {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .filmstrip {
    display: flex;
    gap: 1.1rem;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    padding-bottom: 0.85rem;
    /* soft fade on the trailing edge to signal more content */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 1.5rem,
      #000 calc(100% - 2.5rem),
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 1.5rem,
      #000 calc(100% - 2.5rem),
      transparent 100%
    );
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }
  .filmstrip::-webkit-scrollbar {
    height: 6px;
  }
  .filmstrip::-webkit-scrollbar-thumb {
    background: var(--line);
    border-radius: 100px;
  }

  .group {
    margin: 0;
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  /* The framed screen. Border/rounding wraps the whole screen, not each panel. */
  .panels {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 2px rgba(26, 26, 26, 0.04);
  }

  .panel {
    position: relative;
    flex: 0 0 auto;
    width: var(--box-w);
    height: var(--box-h);
    overflow: hidden;
    background: #fff;
  }
  /* hairline marks where a tall screen was sliced */
  .panel + .panel {
    border-left: 1px solid var(--line);
  }

  .panel img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    display: block;
    transform: translateY(calc(-1 * var(--offset)));
  }

  .cap {
    margin-top: 0.7rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--ink-faint);
    text-align: center;
  }

  :global(:focus-visible).filmstrip {
    outline: 2px solid var(--ink);
    outline-offset: 4px;
  }

  @media (max-width: 480px) {
    .filmstrip-wrap {
      /* let the strip bleed to the screen edges on mobile for more room */
      margin-inline: calc(-1 * var(--gutter));
    }
    .head {
      padding-inline: var(--gutter);
    }
    .filmstrip {
      padding-inline: var(--gutter);
    }
  }
</style>
