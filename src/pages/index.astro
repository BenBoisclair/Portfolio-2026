---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import { profile } from "../data/portfolio";

const title = `${profile.name} | ${profile.role}`;
const description =
  "Backend-focused full-stack engineer in Bangkok who takes products from idea to production in under two months. EventLink, TasteMap, Rubie Wallet.";
---

<BaseLayout title={title} description={description}>
  <Hero />
  <main>
    <FeaturedWork />
    <ExperienceTimeline />
    <Skills />
  </main>
  <Contact />
</BaseLayout>
