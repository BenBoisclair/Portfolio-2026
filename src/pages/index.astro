---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import ExperienceTimeline from "../components/ExperienceTimeline.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import { profile } from "../data/portfolio";

const title = `${profile.name} | ${profile.role}`;
const description =
  "Backend-focused full-stack engineer in Bangkok who takes products from idea to production in under two months. EventLink, TasteMap, Rubie Wallet.";

const siteUrl = (Astro.site ?? new URL("http://localhost")).toString().replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  url: siteUrl,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Bangkok",
    addressCountry: "TH",
  },
  sameAs: [profile.linkedin.url, profile.github.url],
};
---

<BaseLayout title={title} description={description} ogImage="/og.png">
  <Hero />
  <main>
    <FeaturedWork />
    <ExperienceTimeline />
    <Skills />
  </main>
  <Contact />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
</BaseLayout>
