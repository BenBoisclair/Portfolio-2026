---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | Benedict Boisclair"
  description="This page wandered off."
>
  <main class="notfound">
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 class="display headline">
        This page<br /><em>wandered off.</em>
      </h1>
      <p class="sub">The link may be broken, or the page has moved.</p>
      <a class="home mono" href="/">
        <span aria-hidden="true">←</span> Back to home
      </a>
    </div>
  </main>
</BaseLayout>

<style>
  .notfound {
    min-height: 82vh;
    display: flex;
    align-items: center;
    padding-block: clamp(3rem, 10vw, 6rem);
  }
  .headline {
    font-size: clamp(2.75rem, 9vw, 5rem);
    margin: 0.5rem 0 0;
  }
  .sub {
    margin: 1.5rem 0 0;
    color: var(--ink-soft);
    max-width: 40ch;
  }
  .home {
    display: inline-block;
    margin-top: 2.25rem;
    font-size: 0.82rem;
    text-decoration: none;
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
    transition: opacity 0.15s ease;
  }
  .home:hover {
    opacity: 0.6;
  }
</style>
