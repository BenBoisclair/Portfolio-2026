---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Optional social-preview image path, e.g. "/og.png". Add at deploy time. */
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

// Astro.site is set in astro.config.mjs - update it to the real domain on deploy.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site ?? Astro.url).toString()
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f7" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preload display + data faces; they set the tone above the fold -->
    <link
      rel="preload"
      href="/fonts/InstrumentSerif-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SpaceMono-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <!-- Twitter -->
    <meta
      name="twitter:card"
      content={ogImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
  </head>
  <body>
    <slot />
  </body>
</html>
